# ============================================================
# 复制本文件为 .env，然后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库
# ============================================================
# 变量名刻意与厂商无关（LLM_*）：以后换 DeepSeek / Kimi / 自建服务
# 只改本文件，代码一行都不用动。

# 【必填】API Key
# 阿里云百炼：https://bailian.console.aliyun.com/ → 右上角「API-KEY」
LLM_API_KEY=

# 【必填】接口地址（OpenAI 兼容模式）
# 百炼北京经典地址：https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼工作区地址：  https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 百炼新加坡：      https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# 【必填】模型 ID
# 千问常用：qwen-plus（均衡）/ qwen-turbo（最快最省）/ qwen-max（最强）
#          qwen3.8-max（支持 json_schema 严格结构化输出）
LLM_MODEL=
