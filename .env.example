# ============================================================
# 复制本文件为 .env，然后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库
# ============================================================

# 【必填】阿里云百炼 API Key
# 获取地址：https://bailian.console.aliyun.com/  →  右上角「API-KEY」
# 形如 sk-xxxxxxxxxxxxxxxx
DASHSCOPE_API_KEY=

# 【选填】使用的模型。留空则用代码默认值 qwen-plus
# 可选：qwen-plus（均衡）/ qwen-turbo（最快最便宜）/ qwen-max（最强）
#      qwen3.8-max（新一代，支持 json_schema 严格结构化输出）
APP_MODEL=

# 【选填】百炼接口地址。留空则用北京地域经典地址
#   北京：https://dashscope.aliyuncs.com/compatible-mode/v1  ← 默认
#   新加坡：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=
